        <mxCell id="1DrydrTIw0HsEDlRlWk--55" connectable="0" parent="1DrydrTIw0HsEDlRlWk--54" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" value="Streaming Replication" vertex="1">
          <mxGeometry relative="1" x="-0.076" y="-1" as="geometry">
