        <mxCell id="1DrydrTIw0HsEDlRlWk--1" parent="1" style="shape=image;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" value="" vertex="1">
